{
  "name": "diagramify-ai",
  "version": "0.2.1",
  "description": "Open-source AI-powered Mermaid diagram generator with interactive HTML, SVG, PNG, CLI, React, and agent skill support.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "bin": {
    "diagramify": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run audit:prod",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "release": "np",
    "release:patch": "np patch",
    "release:minor": "np minor",
    "release:major": "np major"
  },
  "np": {
    "yarn": false,
    "contents": ".",
    "testScript": "check",
    "anyBranch": false,
    "branch": "main",
    "preview": false,
    "message": "chore: release v%s"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/google": "^4.0.59",
    "@ai-sdk/openai": "^4.0.53",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.87",
    "beautiful-mermaid": "^1.1.3",
    "commander": "^12.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.0",
    "ignore": "^5.3.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^9.39.5",
    "np": "^12.0.1",
    "simple-icons": "^16.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "architecture",
    "flowchart",
    "claude",
    "openai",
    "gemini",
    "ai",
    "svg",
    "codebase",
    "visualization",
    "claude-code",
    "skill",
    "open-source"
  ],
  "license": "MIT",
  "author": "Opeyemi Babalola",
  "repository": {
    "type": "git",
    "url": "https://github.com/BabalolaBrainiac/diagramify.git"
  },
  "homepage": "https://github.com/BabalolaBrainiac/diagramify#readme",
  "bugs": {
    "url": "https://github.com/BabalolaBrainiac/diagramify/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
